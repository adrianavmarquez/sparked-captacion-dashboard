{
  "name": "sparked-dashboard-captacion",
  "private": true,
  "version": "0.1.0",
  "description": "Dashboard interno de captación de Sparked Reactions. La demo sigue offline; el API queda inactivo sin credenciales.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "build:artifact": "vite build --config vite.artifact.config.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@electric-sql/pglite": "^0.3.14",
    "@netlify/functions": "^4.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}